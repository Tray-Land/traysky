<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="ExploreRowStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Submitting opens the search page (a lone #tag goes straight to the hashtag page).  -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Margin="12,4,12,8"
            PlaceholderText="Search Bluesky"
            QueryIcon="Find"
            QuerySubmitted="SearchBox_QuerySubmitted" />

        <SelectorBar
            x:Name="Tabs"
            Grid.Row="1"
            Margin="8,0,8,4"
            SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem
                x:Name="TrendingTab"
                IsSelected="True"
                Text="Trending" />
            <SelectorBarItem x:Name="PeopleTab" Text="People" />
            <SelectorBarItem x:Name="FeedsTab" Text="Feeds" />
        </SelectorBar>

        <InfoBar
            Grid.Row="2"
            Margin="12,0,12,8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3">
            <!--  Trending topics  -->
            <ListView
                x:Name="TrendList"
                IsItemClickEnabled="True"
                ItemClick="TrendList_ItemClick"
                ItemContainerStyle="{StaticResource ExploreRowStyle}"
                ItemsSource="{x:Bind ViewModel.Trends}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="items:TrendItem">
                        <Grid Padding="12,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xEAFC;" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind Detail}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasDetail}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Suggested accounts  -->
            <ListView
                x:Name="PeopleList"
                IsItemClickEnabled="True"
                ItemClick="PeopleList_ItemClick"
                ItemContainerStyle="{StaticResource ExploreRowStyle}"
                ItemsSource="{x:Bind ViewModel.People}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="items:ActorItem">
                        <Grid Padding="12,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="{StaticResource AvatarSize}"
                                Height="{StaticResource AvatarSize}"
                                DisplayName="{x:Bind NameOrHandle}"
                                ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind NameOrHandle}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind HandleDisplay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Suggested feeds (open on bsky.app)  -->
            <ListView
                x:Name="FeedList"
                IsItemClickEnabled="True"
                ItemClick="FeedList_ItemClick"
                ItemContainerStyle="{StaticResource ExploreRowStyle}"
                ItemsSource="{x:Bind ViewModel.Feeds}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="items:FeedSuggestionItem">
                        <Grid Padding="12,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="{StaticResource AvatarSize}"
                                Height="{StaticResource AvatarSize}"
                                VerticalAlignment="Top"
                                DisplayName="{x:Bind DisplayName}"
                                ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ByLine}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    MaxLines="3"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasDescription}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Click="PinFeed_Click"
                                Content="{x:Bind PinLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="Add to or remove from your feed tabs"
                                Visibility="{x:Bind CanPin}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
