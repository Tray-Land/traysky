<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.StarterPackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="MemberList"
            IsItemClickEnabled="True"
            ItemClick="MemberList_ItemClick"
            ItemsSource="{x:Bind ViewModel.Members}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>
                <StackPanel>
                    <StackPanel Margin="12,12,12,8" Spacing="2">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.ByLine, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Margin="12,0,12,8" Spacing="6">
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasFeeds, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Feeds in this pack" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Feeds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button
                            Command="{x:Bind ViewModel.FollowAllCommand}"
                            Content="{x:Bind ViewModel.FollowAllLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.ShowFollowAll, Mode=OneWay}" />
                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsFollowingAll, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <ProgressBar
                                    IsIndeterminate="{x:Bind ViewModel.IsFollowTotalUnknown, Mode=OneWay}"
                                    Maximum="{x:Bind ViewModel.FollowTotal, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.FollowDone, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.FollowProgress, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Command="{x:Bind ViewModel.FollowAllCancelCommand}"
                                Content="Cancel" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.FollowSummary, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasFollowSummary, Mode=OneWay}" />
                    </StackPanel>
                    <InfoBar
                        Margin="12,0,12,8"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Retry" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <TextBlock
                        Margin="12,0,12,8"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="No accounts in this starter pack."
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:ActorItem">
                    <Grid Padding="12,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture
                            Width="{StaticResource AvatarSize}"
                            Height="{StaticResource AvatarSize}"
                            DisplayName="{x:Bind NameOrHandle}"
                            ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind NameOrHandle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind HandleDisplay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <StackPanel Margin="12,8" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenInBrowserCommand}"
                        Content="Open on bsky.app" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
