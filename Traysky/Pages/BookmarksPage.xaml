<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.BookmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Traysky.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="PostList"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Posts}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>
                <StackPanel>
                    <TextBlock
                        Margin="12,12,12,8"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Bookmarks" />
                    <InfoBar
                        Margin="12,0,12,8"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Retry" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <TextBlock
                        Margin="12,0,12,8"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="No bookmarks yet. Use a post's … menu to save it here."
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:PostItem">
                    <Grid>
                        <controls:PostCard Post="{x:Bind}" ThreadRequested="PostCard_ThreadRequested" />
                        <Rectangle
                            Height="1"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <ProgressRing
                    Width="20"
                    Height="20"
                    Margin="12,8"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
