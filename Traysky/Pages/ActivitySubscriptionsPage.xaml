<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.ActivitySubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ListView
        x:Name="PeopleList"
        IsItemClickEnabled="True"
        ItemClick="PeopleList_ItemClick"
        ItemsSource="{x:Bind ViewModel.Accounts}"
        SelectionMode="None">
        <ListView.Header>
            <TextBlock
                Margin="12,4,12,8"
                Style="{StaticResource SettingDescriptionStyle}"
                Text="Accounts you get a notification from when they post. Turn one on from the bell on their profile." />
        </ListView.Header>
        <ListView.ItemContainerStyle>
            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="items:ActorItem">
                <Grid Padding="12,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        Width="{StaticResource AvatarSize}"
                        Height="{StaticResource AvatarSize}"
                        DisplayName="{x:Bind NameOrHandle}"
                        ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind NameOrHandle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind HandleDisplay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ManagedDetail}"
                            Visibility="{x:Bind HasManagedDetail}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="TurnOff_Click"
                        Content="{x:Bind ManagedActionLabel}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
        <ListView.Footer>
            <StackPanel Margin="12,8" Spacing="8">
                <ProgressRing
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="You haven't turned on notifications for anyone"
                    Visibility="Collapsed" />
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Retry" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </ListView.Footer>
    </ListView>
</Page>
