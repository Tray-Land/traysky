<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Traysky.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PostRowTemplate" x:DataType="items:PostItem">
            <Grid>
                <controls:PostCard Post="{x:Bind}" ThreadRequested="PostCard_ThreadRequested" />
                <!--  No divider where a connector line runs on into the next row.  -->
                <Rectangle
                    Height="1"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind ShowDivider}" />
            </Grid>
        </DataTemplate>

        <!--  Between a thread's first post and the post replied to: a dotted line and "Load more".  -->
        <DataTemplate x:Key="GapRowTemplate" x:DataType="items:ThreadGapItem">
            <Grid
                MinHeight="36"
                Padding="12,0"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="{StaticResource AvatarSize}">
                    <Line
                        HorizontalAlignment="Center"
                        Stretch="Fill"
                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        StrokeDashArray="1,2"
                        StrokeThickness="2"
                        X1="0"
                        X2="0"
                        Y1="0"
                        Y2="1" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <HyperlinkButton
                        Padding="0,4"
                        Click="GapButton_Click"
                        Content="Load more"
                        Tag="{x:Bind}" />
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <helpers:TimelineRowTemplateSelector
            x:Key="RowSelector"
            GapTemplate="{StaticResource GapRowTemplate}"
            PostTemplate="{StaticResource PostRowTemplate}" />
    </Page.Resources>

    <Grid>
        <!--  Pull to refresh. RefreshContainer's pull gesture is touch/pen only; mouse users have the tab re-click.  -->
        <RefreshContainer RefreshRequested="RefreshContainer_RefreshRequested">
            <ListView
                x:Name="PostList"
                IsItemClickEnabled="False"
                ItemTemplateSelector="{StaticResource RowSelector}"
                ItemsSource="{x:Bind ViewModel.Rows}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Footer>
                    <Grid Height="40">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
                    </Grid>
                </ListView.Footer>
            </ListView>
        </RefreshContainer>

        <!--  First load  -->
        <ProgressRing
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!--  Empty / error states  -->
        <StackPanel
            MaxWidth="240"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="28"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE80F;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Your timeline is empty. Follow some people on bsky.app and it fills up here."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            Margin="12"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
